# Exchange API Credentials
# Copy this file to .env and fill in your credentials

# Binance
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
BINANCE_SANDBOX=false

# Bybit
BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here
BYBIT_SANDBOX=false

# OKX
OKX_API_KEY=your_api_key_here
OKX_API_SECRET=your_api_secret_here
OKX_PASSWORD=your_passphrase_here
OKX_SANDBOX=false

# KuCoin
KUCOIN_API_KEY=your_api_key_here
KUCOIN_API_SECRET=your_api_secret_here
KUCOIN_PASSWORD=your_passphrase_here
KUCOIN_SANDBOX=false

# Gate.io
GATE_API_KEY=your_api_key_here
GATE_API_SECRET=your_api_secret_here
GATE_SANDBOX=false

# HTX (Huobi)
HTX_API_KEY=your_api_key_here
HTX_API_SECRET=your_api_secret_here
HTX_SANDBOX=false

# MEXC
MEXC_API_KEY=your_api_key_here
MEXC_API_SECRET=your_api_secret_here
MEXC_SANDBOX=false

# Bitget
BITGET_API_KEY=your_api_key_here
BITGET_API_SECRET=your_api_secret_here
BITGET_PASSWORD=your_passphrase_here
BITGET_SANDBOX=false
